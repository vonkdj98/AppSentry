<UserControl x:Class="AppSentry.Views.InstalledView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,0,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Tag="&#xE72C;" ContentTemplate="{StaticResource GlyphLabel}" Content="Refresh" VerticalAlignment="Center" />
                <TextBlock Text="Installed apps" Style="{StaticResource PageTitle}" />
            </DockPanel>

            <WrapPanel DockPanel.Dock="Top" Margin="0,14,0,4">
                <Grid Width="260" Margin="0,0,10,6">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,8,5" AutomationProperties.Name="Search installed apps" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Search name, publisher, folder" Style="{StaticResource Caption}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                </Grid>
                <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" Width="160" Margin="0,0,6,6" AutomationProperties.Name="Scope" />
                <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Width="170" Margin="0,0,6,6" AutomationProperties.Name="Sort by" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding RecentOnly}" Content="Installed in the last 7 days" Margin="4,0,6,6" />
            </WrapPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="2,0,0,6" />

            <Grid>
                <ListView ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Installed apps">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="50" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" HorizontalAlignment="Left">
                                    <Border CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" />
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Border Height="4" CornerRadius="2" HorizontalAlignment="Left" Margin="0,4,0,0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.7"
                                            Width="{Binding SizeFraction, Converter={StaticResource FractionToWidth}, ConverterParameter=90}"
                                            Visibility="{Binding SizeText, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding InstalledOnText}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="Loading…" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0,44,0,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Details}"
                              Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <StackPanel Margin="20,18,20,20">
                        <Grid DataContext="{Binding Item}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Border CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleText}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Details" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Command="{Binding OpenFolderCommand}" Tag="&#xE838;" ContentTemplate="{StaticResource GlyphLabel}" Content="Open folder" Margin="0,0,8,8"
                                    Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding UninstallCommand}" Tag="&#xE74D;" ContentTemplate="{StaticResource GlyphLabel}" Content="Uninstall…" Margin="0,0,8,8"
                                    Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding ExcludeCommand}" Tag="&#xE71C;" ContentTemplate="{StaticResource GlyphLabel}" Content="Exclude…" Margin="0,0,8,8"
                                    Visibility="{Binding CanExclude, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding CopyCommand}" Tag="&#xE8C8;" ContentTemplate="{StaticResource GlyphLabel}" Content="Copy details" Margin="0,0,8,8" />
                        </WrapPanel>

                        <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="History" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="-8,0,0,2"
                                                Command="{Binding DataContext.ShowEventCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ToneGlyph}" Text="{Binding Glyph}" FontSize="13" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding FullTime}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="Select an app to see its details and history." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Details, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
