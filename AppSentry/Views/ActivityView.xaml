<UserControl x:Class="AppSentry.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:AppSentry.Views">
    <UserControl.Resources>
        <!-- Row: app icon (or source glyph) with a type badge, name + summary, flag + time. -->
        <DataTemplate x:Key="EventRow">
            <Grid Height="52" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding SourceGlyph}" FontSize="17" HorizontalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <TextBlock Style="{StaticResource ToneGlyph}" Text="{Binding Glyph}" FontSize="11" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ToneText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFlagged}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Content="{Binding FlagBadge}" ContentTemplate="{StaticResource BadgeTemplate}" Margin="0,0,10,0" Focusable="False"
                                    Visibility="{Binding NeedsLook, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Caption}" ToolTip="{Binding FullTime}" MinWidth="36" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="12,0,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource PageTitle}" />

            <!-- Summary cards: click to filter. -->
            <Grid DockPanel.Dock="Top" Margin="0,14,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource CardButton}" Command="{Binding CardCommand}" CommandParameter="Installed" AutomationProperties.Name="Show installs">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="13" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Installed" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Text="{Binding InstalledCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource CardButton}" Command="{Binding CardCommand}" CommandParameter="Updated" AutomationProperties.Name="Show updates">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" FontSize="13" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Updated" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdatedCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource CardButton}" Command="{Binding CardCommand}" CommandParameter="Removed" AutomationProperties.Name="Show removals">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="13" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Removed" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RemovedCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding RangeLabel}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Command="{Binding CardCommand}" CommandParameter="attention" Margin="0" AutomationProperties.Name="Show items that need a look">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CardButton}">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </Button.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="13" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="Needs a look" Style="{StaticResource Caption}" />
                        </StackPanel>
                        <TextBlock Text="{Binding NeedsLookCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsLookCount}" Value="0">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="not yet reviewed" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filters -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Grid Width="240" Margin="0,0,10,6">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,8,5"
                             AutomationProperties.Name="Search changes" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="Search apps, people, versions" Style="{StaticResource Caption}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                </Grid>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FilterInstalled}" Content="Installed" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FilterUpdated}" Content="Updated" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FilterRemoved}" Content="Removed" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FilterModified}" Content="Modified" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding FilterFailed}" Content="Failed" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding NeedsLookOnly}" Tag="&#xE7BA;"
                              ContentTemplate="{StaticResource GlyphLabel}" Content="Needs a look" />

                <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" Width="170" Margin="4,0,6,6"
                          AutomationProperties.Name="Source" />
                <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" Width="140" Margin="0,0,6,6"
                          AutomationProperties.Name="Time range" />
                <Button Style="{StaticResource SubtleButton}" Command="{Binding ClearFiltersCommand}" Margin="0,0,0,6"
                        Tag="&#xE711;" ContentTemplate="{StaticResource GlyphLabel}" Content="Clear filters"
                        Visibility="{Binding HasFiltersActive, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>

            <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                <Button DockPanel.Dock="Right" Command="{Binding MarkAllReviewedCommand}" Padding="10,3" FontSize="12"
                        Tag="&#xE73E;" ContentTemplate="{StaticResource GlyphLabel}" Content="Mark all reviewed"
                        Visibility="{Binding NeedsLookCount, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding ResultText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </DockPanel>

            <Grid>
                <ListView x:Name="EventList" ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource EventRow}"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          AutomationProperties.Name="Changes">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="10,14,0,4"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyBody}" Style="{StaticResource Body}" TextAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- Details pane -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0,44,0,0">
            <Grid>
                <v:EventDetailsView DataContext="{Binding Details}"
                                    Visibility="{Binding DataContext.Details, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="Select a change to see what happened." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Details, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
