<UserControl x:Class="AppSentry.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One settings row: label + description on the left, a control on the right. -->
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,12" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,0,20,24" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

            <!-- Monitoring -->
            <TextBlock Text="Monitoring" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{Binding ModeTitle}" Style="{StaticResource RowLabel}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ModeBody}" Style="{StaticResource RowHint}" />
                            <TextBlock Style="{StaticResource RowHint}"><Run Text="Service: " /><Run Text="{Binding ServiceStatusText, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ServiceCommand}" Content="{Binding ServiceActionText}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid IsEnabled="{Binding CanModify}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Real-time monitoring" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="Scan within seconds when the registry, the Windows Installer log or a Program Files folder changes." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RealtimeEnabled}" VerticalAlignment="Center" AutomationProperties.Name="Real-time monitoring" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid IsEnabled="{Binding CanModify}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Full scan" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="A safety net that catches anything real-time notifications missed." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding SelectedInterval}" Width="200" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <TextBlock Text="Notifications" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Show notifications" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="Windows notifications with View and Exclude buttons. They follow Do Not Disturb." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding TestNotificationCommand}" Content="Send a test" Margin="0,0,16,0" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled}" VerticalAlignment="Center" AutomationProperties.Name="Show notifications" />
                        </StackPanel>
                    </Grid>
                    <Border Padding="10,8" CornerRadius="6" Margin="0,10,0,0" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding ResumeCommand}" Content="Resume"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding PausedText}" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Divider}" />
                    <StackPanel IsEnabled="{Binding NotificationsEnabled}">
                        <TextBlock Text="Notify me about" Style="{StaticResource RowLabel}" />
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox Content="Installs" IsChecked="{Binding NotifyInstalled}" Margin="0,0,20,6" />
                            <CheckBox Content="Updates" IsChecked="{Binding NotifyUpdated}" Margin="0,0,20,6" />
                            <CheckBox Content="Removals" IsChecked="{Binding NotifyRemoved}" Margin="0,0,20,6" />
                            <CheckBox Content="Modifications" IsChecked="{Binding NotifyModified}" Margin="0,0,20,6" />
                            <CheckBox Content="Failed installs" IsChecked="{Binding NotifyFailed}" Margin="0,0,20,6" />
                        </WrapPanel>
                        <CheckBox Content="Always notify about changes that need a look, even if their type is off" IsChecked="{Binding AlwaysNotifyAttention}" Margin="0,6,0,0" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="Keep notifications on screen" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="They stay in Notification Center either way." Style="{StaticResource RowHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding OnScreenOptions}" SelectedItem="{Binding SelectedOnScreen}" Width="240" VerticalAlignment="Center"
                                      AutomationProperties.Name="Keep notifications on screen" />
                        </Grid>
                        <CheckBox Content="Keep critical alerts on screen until I dismiss them" IsChecked="{Binding KeepCriticalOnScreen}" Margin="0,8,0,0"
                                  IsEnabled="{Binding CriticalOnScreenApplies}" />
                        <CheckBox Content="Play a sound" IsChecked="{Binding NotificationSound}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance and startup -->
            <TextBlock Text="Appearance and startup" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" Width="200" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="Opens quietly in the notification area when you sign in." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" AutomationProperties.Name="Start with Windows" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Keep running when the window is closed" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="Closing the window leaves AppSentry in the notification area. Exit from its menu." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" VerticalAlignment="Center" AutomationProperties.Name="Keep running when the window is closed" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Data -->
            <TextBlock Text="Data" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid IsEnabled="{Binding CanModify}">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="Keep history" Style="{StaticResource RowLabel}" />
                            <TextBlock Text="Older changes are deleted once a day. Keep everything never deletes anything." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RetentionOptions}" SelectedItem="{Binding SelectedRetention}" Width="200" VerticalAlignment="Center"
                                  AutomationProperties.Name="Keep history" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,10">
                        <Run Text="History is stored in " /><Run Text="{Binding DataDir, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding DataDirNote, Mode=OneWay}" />
                    </TextBlock>
                    <WrapPanel>
                        <Button Command="{Binding ExportCommand}" Tag="&#xE74E;" ContentTemplate="{StaticResource GlyphLabel}" Content="Export history (CSV)" Margin="0,0,8,8" />
                        <Button Command="{Binding OpenDataFolderCommand}" Tag="&#xE838;" ContentTemplate="{StaticResource GlyphLabel}" Content="Open data folder" Margin="0,0,8,8" />
                        <Button Command="{Binding OpenLogCommand}" Tag="&#xE8A5;" ContentTemplate="{StaticResource GlyphLabel}" Content="Show engine log" Margin="0,0,8,8" />
                        <Button Command="{Binding ClearHistoryCommand}" Tag="&#xE74D;" ContentTemplate="{StaticResource GlyphLabel}" Content="Clear history…" Margin="0,0,8,8"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
