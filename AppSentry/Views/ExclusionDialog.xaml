<Window x:Class="AppSentry.Views.ExclusionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exclusion" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" Text="Add exclusion" Style="{StaticResource SubtitleText}" />
        <TextBlock Text="App name or pattern" Style="{StaticResource Caption}" Margin="0,16,0,6" />
        <TextBox x:Name="PatternBox" TextChanged="OnPatternChanged" AutomationProperties.Name="App name or pattern" />
        <TextBlock Text="Exact name, * wildcards, or a name with its version — versions are ignored when matching." Style="{StaticResource Caption}"
                   TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed" />

        <RadioButton x:Name="NotifyOnly" GroupName="Mode" Margin="0,18,0,0" IsChecked="True">
            <StackPanel>
                <TextBlock Text="Don't notify" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Changes are still recorded and shown, just without a notification." Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="DontRecord" GroupName="Mode" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Don't record at all" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="Nothing is saved for matching apps from now on." Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" />
            </StackPanel>
        </RadioButton>

        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="12,10">
            <StackPanel>
                <TextBlock x:Name="PreviewTitle" Text="Matches no past events" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="PreviewNames" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="OnSave" Width="96" Margin="0,0,8,0" />
            <Button Content="Cancel" IsCancel="True" Width="96" />
        </StackPanel>
    </StackPanel>
</Window>
