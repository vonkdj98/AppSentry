<UserControl x:Class="AppSentry.Views.ExclusionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,0,20,24" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Command="{Binding AddCommand}" Tag="&#xE710;"
                        ContentTemplate="{StaticResource GlyphLabel}" Content="Add exclusion" VerticalAlignment="Center" Padding="14,6" />
                <TextBlock Text="Exclusions" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,16"
                       Text="Quiet the apps that change all the time. Match an exact name, use * as a wildcard (7-Zip*, [Scheduled Task] \Adobe*), or rely on version-free matching: an exclusion for &quot;7-Zip 23.01 (x64)&quot; keeps working after it updates." />

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="No exclusions yet" Style="{StaticResource Body}" FontWeight="SemiBold" />
                    <TextBlock Text="Choose Exclude on any change or app to stop its notifications, or to stop recording it altogether." Style="{StaticResource Body}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Pattern}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                        <Run Text="{Binding Effect, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding MatchText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                            IsEnabled="{Binding DataContext.CanModify, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <CheckBox Content="Don't notify" IsChecked="{Binding DontNotify}" Margin="0,0,16,0" />
                                    <CheckBox Content="Don't record" IsChecked="{Binding DontLog}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Edit" AutomationProperties.Name="Edit">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="14" />
                                    </Button>
                                    <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="Remove" AutomationProperties.Name="Remove">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
