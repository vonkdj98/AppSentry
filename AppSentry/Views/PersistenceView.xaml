<UserControl x:Class="AppSentry.Views.PersistenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:AppSentry.Infrastructure">
    <Grid Margin="12,0,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Tag="&#xE72C;" ContentTemplate="{StaticResource GlyphLabel}" Content="Refresh" VerticalAlignment="Center" />
                <TextBlock Text="Services and tasks" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Description}" Style="{StaticResource Body}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,12" />

            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,2">
                <RadioButton Style="{StaticResource SegmentChip}" GroupName="Kind" IsChecked="{Binding IsServices}" Content="Services" />
                <RadioButton Style="{StaticResource SegmentChip}" GroupName="Kind" IsChecked="{Binding IsDrivers}" Content="Drivers" />
                <RadioButton Style="{StaticResource SegmentChip}" GroupName="Kind" IsChecked="{Binding IsTasks}" Content="Scheduled tasks" />
            </WrapPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <CheckBox DockPanel.Dock="Right" Content="Hide Microsoft components" IsChecked="{Binding HideMicrosoft}" VerticalAlignment="Center" Margin="12,0,0,0"
                          Visibility="{Binding CanHideMicrosoft, Converter={StaticResource BoolToVisibility}}" />
                <infra:SearchBox Text="{Binding SearchText}" Placeholder="Search names, paths, accounts" Label="Search" />
            </DockPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="2,0,0,6" />

            <Border DockPanel.Dock="Top" Padding="12,10" CornerRadius="6" Margin="0,0,0,8" Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                    Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource Body}" FontSize="13" />
            </Border>

            <ListView ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Services and tasks">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="Margin" Value="0,1" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <infra:AppTile Icon="{Binding Icon}" Label="{Binding Title}" Glyph="{Binding Glyph}" TileSize="34" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <ContentControl Grid.Column="2" Content="{Binding MicrosoftBadge}" ContentTemplate="{StaticResource BadgeTemplate}" VerticalAlignment="Center" Focusable="False"
                                            Visibility="{Binding IsMicrosoft, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0,44,0,0">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                              Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <StackPanel Margin="20,18,20,20">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleText}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                        <TextBlock Text="Details" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Visibility="{Binding HasSelectedHistory, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="History" Style="{StaticResource SectionHeader}" />
                            <ItemsControl ItemsSource="{Binding SelectedHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="-8,0,0,2"
                                                Command="{Binding DataContext.ShowEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ToneGlyph}" Text="{Binding Glyph}" FontSize="13" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding FullTime}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="Select an item to see what it runs." Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
