<UserControl x:Class="AppSentry.Views.EventDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,18,20,20">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top" DataContext="{Binding Item}">
                    <Border CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Style="{StaticResource Glyph}" Text="{Binding SourceGlyph}" FontSize="24" HorizontalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleText}" />
                    <TextBlock Text="{Binding SubtitleLine}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,6" />
                    <ContentControl Content="{Binding TypeBadge}" ContentTemplate="{StaticResource BadgeTemplate}" HorizontalAlignment="Left" Focusable="False" />
                </StackPanel>
            </Grid>

            <!-- Why it's flagged -->
            <Border Margin="0,16,0,0" Padding="12,10" DataContext="{Binding AttentionBadge}" Style="{StaticResource ToneBackground}" CornerRadius="6"
                    Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ToneGlyph}" Text="{Binding Glyph}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13" />
                </Grid>
            </Border>
            <Button Command="{Binding ToggleReviewedCommand}" Content="{Binding ReviewButtonText}" Tag="&#xE73E;" ContentTemplate="{StaticResource GlyphLabel}"
                    HorizontalAlignment="Left" Margin="0,8,0,0"
                    Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Sentence}" Style="{StaticResource Body}" Margin="0,14,0,0" />

            <!-- What changed -->
            <StackPanel Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="What changed" Style="{StaticResource SectionHeader}" />
                <ItemsControl ItemsSource="{Binding DiffRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                                <TextBlock x:Name="Old" Text="{Binding OldValue, StringFormat='− {0}'}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <TextBlock x:Name="New" Text="{Binding NewValue, StringFormat='+ {0}'}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                    <Setter TargetName="Old" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                    <Setter TargetName="New" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Same">
                                    <Setter TargetName="Old" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="New" Property="Text" Value="{Binding NewValue}" />
                                    <Setter TargetName="New" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox Content="{Binding ShowUnchangedLabel}" IsChecked="{Binding ShowUnchanged}" Margin="0,2,0,0"
                          Visibility="{Binding UnchangedCount, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <!-- Facts -->
            <TextBlock Text="Details" Style="{StaticResource SectionHeader}" />
            <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Actions: an edition's first (Show traffic, Block…), then the app's own -->
            <ItemsControl ItemsSource="{Binding EditionActions}" Focusable="False" Margin="0,12,0,0"
                          Visibility="{Binding HasEditionActions, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding Command}" Tag="{Binding Glyph}" ContentTemplate="{StaticResource GlyphLabel}" Content="{Binding Text}" Margin="0,0,8,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,4,0,0">
                <Button Command="{Binding OpenFolderCommand}" Tag="&#xE838;" ContentTemplate="{StaticResource GlyphLabel}" Content="Open folder" Margin="0,0,8,8"
                        Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVisibility}}" />
                <Button Command="{Binding ExcludeCommand}" Tag="&#xE71C;" ContentTemplate="{StaticResource GlyphLabel}" Content="Exclude…" Margin="0,0,8,8"
                        Visibility="{Binding CanExclude, Converter={StaticResource BoolToVisibility}}" />
                <Button Command="{Binding UninstallCommand}" Tag="&#xE74D;" ContentTemplate="{StaticResource GlyphLabel}" Content="Uninstall…" Margin="0,0,8,8"
                        Visibility="{Binding CanUninstall, Converter={StaticResource BoolToVisibility}}" />
                <Button Command="{Binding CopyRecordCommand}" Tag="&#xE8C8;" ContentTemplate="{StaticResource GlyphLabel}" Content="Copy as change record" Margin="0,0,8,8"
                        ToolTip="Copies a bulleted summary for a change ticket" />
                <Button Command="{Binding CopyDetailsCommand}" Tag="&#xE8C8;" ContentTemplate="{StaticResource GlyphLabel}" Content="Copy details" Margin="0,0,8,8" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
