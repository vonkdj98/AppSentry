<Window x:Class="AppSentry.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppSentry.ViewModels"
        xmlns:v="clr-namespace:AppSentry.Views"
        Title="AppSentry" Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><v:ActivityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstalledViewModel}"><v:InstalledView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PersistenceViewModel}"><v:PersistenceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExclusionsViewModel}"><v:ExclusionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
            <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ───────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="BrandImage" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="AppSentry" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- Status pill: click for per-source health. -->
            <ToggleButton x:Name="StatusPill" Grid.Column="3" Margin="0,0,12,0" Cursor="Hand" FocusVisualStyle="{x:Null}"
                          AutomationProperties.Name="Monitoring status">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="16" Padding="12,6" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
                <StackPanel Orientation="Horizontal" DataContext="{Binding}">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Success"><Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Accent"><Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Caution"><Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Critical"><Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0" />
                </StackPanel>
            </ToggleButton>
            <Popup IsOpen="{Binding IsChecked, ElementName=StatusPill}" StaysOpen="False" PlacementTarget="{Binding ElementName=StatusPill}"
                   Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Width="340" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding LastScanText}" Style="{StaticResource Body}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusProblem}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                                   Visibility="{Binding StatusProblem, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="Sources" Style="{StaticResource SectionHeader}" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding SourceRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource ToneText}" FontSize="13" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <Button Grid.Column="4" Style="{DynamicResource AccentButtonStyle}" Command="{Binding ScanCommand}" Padding="14,6"
                    Tag="&#xE72C;" ContentTemplate="{StaticResource GlyphLabel}" Content="Scan now" AutomationProperties.Name="Scan now" />
        </Grid>

        <!-- ── Read-only banner (standard user connected to the service) ───── -->
        <Border Grid.Row="1" Margin="20,0,20,8" Padding="14,10" CornerRadius="6"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource Body}" FontSize="13"
                           Text="You can see everything, but only administrators can change settings, exclusions or history on this PC." />
            </StackPanel>
        </Border>

        <!-- ── Navigation + page ────────────────────────────────────────────── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="12,4,8,12">
                <ContentControl DockPanel.Dock="Bottom" Content="{Binding SettingsNav}" ContentTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
                <ItemsControl ItemsSource="{Binding NavItems}" ItemTemplate="{StaticResource NavItemTemplate}" Focusable="False" />
            </DockPanel>
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>

        <!-- ── Message bar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Margin="236,0,20,14" Padding="14,8" CornerRadius="6" HorizontalAlignment="Left"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" FontSize="13" VerticalAlignment="Center" />
                <Button Style="{StaticResource SubtleButton}" Command="{Binding DismissMessageCommand}" Margin="12,0,0,0" Padding="6,2"
                        AutomationProperties.Name="Dismiss">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
