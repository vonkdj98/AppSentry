<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AppSentry</AssemblyName>
    <RootNamespace>AppSentry</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by AppSentry.exe with the export-icon switch; see Services\BrandIcon.cs. -->
    <ApplicationIcon>Assets\AppSentry.ico</ApplicationIcon>
    <StartupObject>AppSentry.Program</StartupObject>
    <!-- WPF0001: Application.ThemeMode (the .NET 9 Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.Main decides between the tray app and the Windows service, so App.xaml is a plain page. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppSentry.Core\AppSentry.Core.csproj" />
  </ItemGroup>

</Project>
